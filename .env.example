# Supabase — projet à créer sur https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : jamais exposée au navigateur, utilisée uniquement
# dans les server actions (création de fiche, réservation, décisions admin).
SUPABASE_SERVICE_ROLE_KEY=

# E-mails transactionnels (optionnel en dev : sans clé, les e-mails sont
# simplement journalisés dans la console du serveur).
RESEND_API_KEY=
EMAIL_FROM="Go & Glow <bonjour@goandglow.fr>"

# URL publique du site (utilisée dans les liens des e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
